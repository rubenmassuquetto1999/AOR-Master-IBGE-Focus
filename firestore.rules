rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Rules for usersProgress
    match /usersProgress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Rules for usersHistory
    match /usersHistory/{historyId} {
      allow get: if request.auth != null && (historyId.startsWith(request.auth.uid) || resource.data.userId == request.auth.uid);
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && (historyId.startsWith(request.auth.uid) || resource.data.userId == request.auth.uid);
      allow create, update: if request.auth != null && (historyId.startsWith(request.auth.uid) || request.resource.data.userId == request.auth.uid);
    }
    
    // Rules for customQuestions
    match /customQuestions/{questionId} {
      allow read, write: if request.auth != null;
    }
  }
}
